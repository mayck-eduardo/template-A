# Copie este arquivo para ".env" e preencha os valores antes do build.
# Variáveis iniciadas com PUBLIC_ são embutidas no HTML no momento do build.

# Exemplo: chave pública do Google Maps (se usar iframe com chave de API).
PUBLIC_GOOGLE_MAPS_KEY=

# Obs.: a maioria das configurações do site (contato, cores, textos)
# fica centralizada em src/data/site.ts — não precisa de .env para isso.
