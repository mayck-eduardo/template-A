---
import { base } from "../data/site";
import { categorias } from "../data/categorias";
import type { Produto } from "../types";
import { ArrowRight } from "@lucide/astro";

interface Props {
  produto: Produto;
}

const { produto } = Astro.props;

const categoria = categorias.find((c) => c.id === produto.categoria);
const srcImagem = `${base}${produto.imagem.replace(/^\//, "")}`;
const urlProduto = `${base}produtos/${produto.id}`;
---

<a
  href={urlProduto}
  class="group bg-card rounded-2xl overflow-hidden border border-gray-200/60 shadow-sm hover:shadow-xl transition-all hover:-translate-y-1 flex flex-col"
>
  <div class="aspect-[4/3] overflow-hidden bg-gray-100 relative">
    <img
      src={srcImagem}
      alt={produto.nome}
      loading="lazy"
      class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
    />
    {
      categoria && (
        <span
          class="absolute top-3 left-3 bg-primary text-white text-[11px] font-heading font-bold uppercase tracking-widest px-3 py-1.5 rounded-full shadow"
        >
          {categoria.nome}
        </span>
      )
    }
  </div>

  <div class="p-5 flex flex-col flex-grow">
    <h3 class="font-heading font-bold text-lg text-ink group-hover:text-primary transition-colors">
      {produto.nome}
    </h3>
    <p class="text-sm text-muted mt-1">{produto.subtitulo}</p>
    <span
      class="mt-4 inline-flex items-center gap-1.5 text-xs font-heading font-bold uppercase tracking-wider text-primary"
    >
      Ver detalhes
      <ArrowRight class="w-4 h-4 transition-transform group-hover:translate-x-1" />
    </span>
  </div>
</a>
